rules_version = '2';

// ==========================================================================
// REGRAS DE SEGURANÇA DO FIRESTORE — Help Desk Matriz
// ==========================================================================
// Cole este conteúdo em: Console do Firebase > Firestore Database > Regras.
//
// Resumo:
// - Qualquer usuário logado pode LER usuários e chamados (visão do time toda).
// - Um usuário pode criar/editar o próprio perfil, mas só um admin pode
//   mudar o campo "papel" (promover/rebaixar) de qualquer usuário.
// - Qualquer usuário logado pode criar chamados.
// - Um chamado só pode ser editado pelo admin OU pelo técnico responsável
//   por ele (para atualizar o status, por exemplo).
// - Apenas admins podem excluir usuários ou chamados.
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return estaLogado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'admin';
    }

    match /usuarios/{userId} {
      allow read: if estaLogado();
      allow create: if estaLogado() && request.auth.uid == userId;
      allow update: if estaLogado() && (
        ehAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.papel == resource.data.papel)
      );
      allow delete: if ehAdmin();
    }

    match /chamados/{chamadoId} {
      allow read: if estaLogado();
      allow create: if estaLogado();
      allow update: if estaLogado() && (
        ehAdmin() ||
        resource.data.responsavelUid == request.auth.uid
      );
      allow delete: if ehAdmin();
    }

    // Relatórios diários de atividades: qualquer logado lê (a tela de
    // Supervisão precisa ver de todos); só o próprio autor cria; autor
    // ou admin pode editar/excluir.
    match /relatorios/{relatorioId} {
      allow read: if estaLogado();
      allow create: if estaLogado() && request.resource.data.tecnicoUid == request.auth.uid;
      allow update, delete: if estaLogado() && (
        ehAdmin() ||
        resource.data.tecnicoUid == request.auth.uid
      );
    }

    // Configuração de máquinas: qualquer logado lê/cria/edita (uso
    // operacional do time); só admin exclui.
    match /maquinas/{maquinaId} {
      allow read: if estaLogado();
      allow create, update: if estaLogado();
      allow delete: if ehAdmin();

      // Histórico de manutenções de cada máquina.
      match /historico/{registroId} {
        allow read: if estaLogado();
        allow create: if estaLogado();
        allow delete: if ehAdmin();
      }
    }

    // Estoque de peças/periféricos.
    match /itensEstoque/{itemId} {
      allow read: if estaLogado();
      allow create, update: if estaLogado();
      allow delete: if ehAdmin();
    }

    // Movimentações de estoque (entradas/saídas). Não são editáveis para
    // preservar o histórico — apenas criadas; exclusão só em caso de erro,
    // restrita ao admin.
    match /movimentacoesEstoque/{movId} {
      allow read: if estaLogado();
      allow create: if estaLogado();
      allow delete: if ehAdmin();
    }
  }
}
